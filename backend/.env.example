# ── Variables del backend ──
PORT=3000
# Cadena de conexión a PostgreSQL (en producción usa la URL de tu proveedor, con ?sslmode=require)
DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/vidaenred
# Clave secreta para firmar los tokens JWT. Mínimo 32 caracteres. OBLIGATORIO cambiarla:
# el servidor no arranca si el valor empieza por "cambia-" o tiene menos de 32 caracteres.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-por-una-clave-larga-y-aleatoria
JWT_EXPIRA=7d
CORS_ORIGIN=*
# Envío de correos (recuperación de contraseña). Sin estas variables el código no llega por correo.
RESEND_API_KEY=
MAIL_FROM=
NODE_ENV=development
# Solo para pruebas automatizadas: base de datos desechable (se borra y recrea en cada prueba)
TEST_DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/vidaenred_test
