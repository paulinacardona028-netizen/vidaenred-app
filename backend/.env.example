# ── Copia este archivo a .env (desarrollo) o define estas variables en tu hosting (producción) ──

# Puerto donde escucha la API (en la mayoría de hostings lo asigna la plataforma)
PORT=3000

# Cadena de conexión a PostgreSQL. En producción usa la URL que te da tu proveedor.
# Ej.: postgres://usuario:clave@host:5432/vidaenred?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vidaenred

# Clave secreta para firmar los tokens JWT. OBLIGATORIO cambiarla.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Duración de la sesión
JWT_EXPIRA=7d

# Origen permitido para CORS. La app móvil no lo necesita; "*" es seguro para la API móvil.
CORS_ORIGIN=*

# "production" desactiva los mensajes de desarrollo (por ejemplo, el código de recuperación en consola)
NODE_ENV=development
