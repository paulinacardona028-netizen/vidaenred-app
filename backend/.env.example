# Puerto donde escucha la API
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vidaenred

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Duración de la sesión
JWT_EXPIRA=7d

# Origen permitido para CORS ("*" en desarrollo)
CORS_ORIGIN=*
