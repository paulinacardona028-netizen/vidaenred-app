{
  "name": "vidaenred-backend",
  "version": "1.0.0",
  "description": "API REST de VidaEnRed (Express + PostgreSQL)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:produccion": "node scripts/migrar.js && node src/index.js",
    "db:migrar": "node scripts/migrar.js",
    "db:importar-entidades": "node scripts/importar-entidades.js",
    "diagnostico": "node scripts/diagnostico.js",
    "test": "node --test test/reglas.test.js test/api.test.js",
    "test:cobertura": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/reglas.test.js test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
